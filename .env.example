# Port the gateway listens on
PORT=8080

# Any OpenAI-compatible endpoint. The default points at the bundled mock (npm run mock).
UPSTREAM_BASE_URL=http://localhost:4001/v1
UPSTREAM_API_KEY=

# SQLite file for tenants, usage and the audit log
DB_PATH=./data/aegis.db
POLICIES_DIR=./policies

# Enables /admin/* endpoints when set
ADMIN_TOKEN=change-me

LOG_LEVEL=info
