# Aegis gateway the dashboard reads from (server-side only)
AEGIS_URL=http://localhost:8080
# Must match ADMIN_TOKEN in the gateway's .env. Not prefixed with NEXT_PUBLIC_, so it never reaches the browser.
AEGIS_ADMIN_TOKEN=change-me

# Signs session cookies. At least 32 random characters; changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
